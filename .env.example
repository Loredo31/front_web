# URL base del backend. Vacío = mismo origen (en desarrollo, a través del proxy de Vite).
# En producción: https://<servicio>.onrender.com
VITE_API_URL=

# Backend al que reenvía el proxy de Vite en desarrollo
VITE_BACKEND_PROXY=http://localhost:8080

# Distribuidor fijo del comercio para /api/pagos
VITE_ID_DISTRIBUIDOR=83
