server {
    listen ${PORT};

    # Archivos estáticos de la aplicación React (Single Page Application)
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
        # index.html siempre se revalida: así cada despliegue nuevo se ve sin borrar la caché del navegador.
        add_header Cache-Control "no-cache" always;
    }

    # Los JS/CSS llevan un hash en el nombre (cambia en cada build): se pueden guardar en caché sin riesgo.
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Proxy inverso transparente hacia el backend en Railway
    location ~ ^/(auth|clientes|cuentas|api) {
        proxy_pass https://${BACKEND_HOST};
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header Origin https://${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_HOST};
        proxy_cookie_domain ${BACKEND_HOST} $host;
    }

    # Proxy para WebSockets (notificaciones de sesión en tiempo real)
    location /ws/ {
        proxy_pass https://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header Origin https://${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_HOST};
    }
}
